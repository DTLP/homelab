name: my-ente
services:
  museum:
    restart: unless-stopped
    image: ghcr.io/ente/server:latest@sha256:c59a19e16626a4fc3e9231c9a11c6fca0b342ba464c9b879635f549b977369fb
    ports:
      - 8080:8080 # API
    depends_on:
      postgres:
        condition: service_healthy
    volumes:
      - ./museum.yaml:/museum.yaml:ro
      - ./data:/data:ro
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/ping"]
      interval: 60s
      timeout: 5s
      retries: 3
      start_period: 5s

  postgres:
    restart: unless-stopped
    image: postgres:18
    environment:
      POSTGRES_DB: ente_db
      POSTGRES_USER: pguser
      POSTGRES_PASSWORD: ${ente_db_password}
    healthcheck:
      test: pg_isready -q -d ente_db -U pguser
      start_period: 40s
      start_interval: 1s
    volumes:
      - postgres-data:/var/lib/postgresql

  backup:
    restart: unless-stopped
    image: ardakilic/postgres-backup-s3:18@sha256:b9adc8dfcdea4c85dd972920cacefe26e83ddddf8ce2cad1433a3a4eca3bf193
    environment:
      SCHEDULE: "@daily"
      BACKUP_KEEP_DAYS: 30
      S3_REGION: ${ente_s3_region}
      S3_ENDPOINT: ${ente_s3_endpoint}
      S3_ACCESS_KEY_ID: ${ente_s3_access_key_id}
      S3_SECRET_ACCESS_KEY: ${ente_s3_secret_access_key}
      S3_BUCKET: ${ente_s3_bucket}
      S3_PREFIX: ${ente_s3_prefix}
      POSTGRES_HOST: postgres
      POSTGRES_DATABASE: ente_db
      POSTGRES_USER: pguser
      POSTGRES_PASSWORD: ${ente_db_password}

volumes:
  postgres-data:
