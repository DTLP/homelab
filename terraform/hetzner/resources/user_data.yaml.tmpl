#cloud-config
packages:
  - bind9-dnsutils
  - curl
  - docker-compose-v2
  - docker.io
  - gnupg
  - openssl
  - psmisc
  - python3
  - rclone
  - unattended-upgrades
  - wireguard
write_files:
  - path: /opt/pangolin/config/traefik/traefik_config.yml
    encoding: b64
    content: ${traefik_config_b64}
  - path: /opt/pangolin/config/traefik/dynamic_config.yml
    encoding: b64
    content: ${traefik_dynamic_config_b64}
  # Ente Photos. Kept in the repo so the stack can be rebuilt from scratch;
  # Postgres is backed up nightly to the S3 bucket in the compose file.
  - path: /opt/ente/compose.yaml
    encoding: b64
    content: ${ente_compose_b64}
    permissions: "0600"
  - path: /opt/ente/museum.yaml
    encoding: b64
    content: ${ente_museum_b64}
    permissions: "0600"
  # Republishes the DANE TLSA records after every certbot renewal. Without it
  # the RRset goes stale each time the certificate is reissued, because
  # external-dns only sources ingress and service records.
  - path: /etc/letsencrypt/renewal-hooks/deploy/50-publish-tlsa
    encoding: b64
    content: ${tlsa_publish_b64}
  - path: /etc/letsencrypt/tlsa.env
    permissions: "0600"
    content: |
      CF_API_TOKEN=${cloudflare_api_token}
      CF_DNS_ZONE=${domain_name}
      CF_TLSA_HOST=${mailserver_hostname}.${domain_name}
      CF_TLSA_PORT=25
  # Verifies the published TLSA records still match the presented certificate
  # every day, and serves a status page UptimeRobot can watch. Kept independent
  # of Pangolin: it is a plain script plus a static file server on port 8082.
  - path: /usr/local/bin/tlsa-check
    encoding: b64
    content: ${tlsa_check_b64}
  # Serves the status file with an explicit text/html content type. The stock
  # http.server would send application/octet-stream for an extensionless file.
  - path: /usr/local/bin/dane-status-server
    encoding: b64
    content: ${dane_status_server_b64}
  # Automatic security updates. unattended-upgrades never reboots on its own;
  # the weekly timer below does that, and only when a reboot is pending.
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
  - path: /etc/apt/apt.conf.d/52mailserver-unattended-upgrades
    permissions: "0644"
    content: |
      // Keep old kernels in the GRUB menu so a bad boot can be rolled back
      // from the Hetzner console.
      Unattended-Upgrade::Automatic-Reboot "false";
      Unattended-Upgrade::Remove-Unused-Kernel-Packages "false";
      Unattended-Upgrade::Remove-Unused-Dependencies "false";
  # Rebooting is the only step that can take the server offline, so check for
  # a half-finished dpkg run or a full disk first and report what is pending.
  - path: /usr/local/bin/reboot-if-required
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      if [[ ! -f /var/run/reboot-required ]]; then
        exit 0
      fi

      if fuser -s /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock \
        /var/lib/apt/lists/lock 2>/dev/null; then
        logger -t reboot-if-required "not rebooting: apt/dpkg is busy"
        exit 1
      fi

      if systemctl is-active --quiet apt-daily-upgrade.service; then
        logger -t reboot-if-required "not rebooting: apt-daily-upgrade is running"
        exit 1
      fi

      if dpkg --audit | grep -q .; then
        logger -t reboot-if-required "not rebooting: dpkg reports a broken package state"
        exit 1
      fi

      if [[ $(df --output=pcent / | tail -1 | tr -dc '0-9') -ge 90 ]]; then
        logger -t reboot-if-required "not rebooting: root filesystem is almost full"
        exit 1
      fi

      pending=$(cat /var/run/reboot-required.pkgs 2>/dev/null || true)
      logger -t reboot-if-required "rebooting for pending updates: $pending"
      systemctl reboot
  - path: /etc/systemd/system/reboot-if-required.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Reboot the mail server if an update requires it
      ConditionPathExists=/var/run/reboot-required

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/reboot-if-required
  - path: /etc/systemd/system/reboot-if-required.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Weekly check for a pending mail server reboot

      [Timer]
      OnCalendar=Sun *-*-* 08:00:00 Europe/London
      Persistent=true

      [Install]
      WantedBy=timers.target
  - path: /usr/local/bin/email-backup
    encoding: b64
    content: ${email_backup_b64}
    permissions: "0755"
  - path: /etc/email-backup/passphrase
    encoding: b64
    content: ${email_backup_password_b64}
    permissions: "0600"
  - path: /etc/email-backup/rclone.conf
    encoding: b64
    content: ${rclone_config_b64}
    permissions: "0600"
  - path: /etc/systemd/system/email-backup.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Encrypted email backup to Dropbox
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/email-backup
      Environment=BACKUP_RETENTION_DAYS=${backup_retention_days}
      Nice=10
      IOSchedulingClass=best-effort
      IOSchedulingPriority=7
      TimeoutStartSec=1h
  - path: /etc/systemd/system/email-backup.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Daily email backup to Dropbox

      [Timer]
      OnCalendar=*-*-* 03:30:00 Europe/London
      Persistent=true
      RandomizedDelaySec=15m

      [Install]
      WantedBy=timers.target
  - path: /usr/local/bin/docker-metadata-block
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      iptables -C OUTPUT -d 169.254.169.254/32 -j DROP 2>/dev/null \
        || iptables -I OUTPUT -d 169.254.169.254/32 -j DROP
      if iptables -S DOCKER-USER >/dev/null 2>&1; then
        iptables -C DOCKER-USER -d 169.254.169.254/32 -j DROP 2>/dev/null \
          || iptables -I DOCKER-USER -d 169.254.169.254/32 -j DROP
      fi
  - path: /etc/systemd/system/docker-metadata-block.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Block container access to the Hetzner metadata service
      After=docker.service
      Requires=docker.service

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/docker-metadata-block
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
  - path: /etc/systemd/journald.conf.d/99-size.conf
    permissions: "0644"
    content: |
      [Journal]
      SystemMaxUse=200M
      SystemMaxFileSize=50M
      RuntimeMaxUse=50M
  - path: /usr/local/bin/disk-check
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      usage=$(df --output=pcent / | tail -n1 | tr -dc '0-9')
      if ((usage >= 80)); then
        status="FAILED"
      else
        status="OK"
      fi
      printf '%s disk: %s (%s%%)\n' "$(date -Is)" "$status" "$usage" \
        > /opt/dane-status/disk
runcmd:
  # disable SSH password authentication
  - sed -i 's/^#\?PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config
  - systemctl restart ssh

  # wireguard vpn
  - systemctl start wg-quick@wg0
  - systemctl enable wg-quick@wg0
  - |
    cat <<EOF > /etc/wireguard/wg0.conf
    [Interface]
    Address = ${wg_server_private_ip_address}/32
    PrivateKey = ${wg_server_private_key}
    ListenPort = ${wg_server_endpoint_port}

    [Peer]
    PublicKey = ${wg_client_public_key}
    AllowedIPs = ${wg_client_private_ip_address}/32
    EOF
  - systemctl daemon-reload
  - systemctl start wg-quick@wg0

  # docker
  - systemctl start docker
  - systemctl enable docker

  # certificate
  - chmod 0700 /etc/letsencrypt/tlsa.env
  - chmod 0755 /etc/letsencrypt/renewal-hooks/deploy/50-publish-tlsa
  - |
    docker run --rm \
      -v "/etc/letsencrypt/:/etc/letsencrypt/" \
      -v "/var/log/letsencrypt/:/var/log/letsencrypt/" \
      -p 80:80 \
      certbot/certbot certonly --standalone \
        --non-interactive --agree-tos \
        --email postmaster@${domain_name} \
        --keep-until-expiring \
        -d ${mailserver_hostname}.${domain_name}
  - |
    test -f "/etc/letsencrypt/live/${mailserver_hostname}.${domain_name}/fullchain.pem" \
      || { echo "certbot failed to issue a certificate" >&2; exit 1; }
  # Publish the TLSA records for the certificate just issued, so DANE is
  # correct from the first boot rather than only after the next renewal.
  - /etc/letsencrypt/renewal-hooks/deploy/50-publish-tlsa
  - |
    echo "# run certbot renew every Sunday at 2am" >> /etc/crontab
  - |
    echo "0 2 * * 0 root /usr/bin/docker run --rm \
      -v \"/etc/letsencrypt/:/etc/letsencrypt/\" \
      -v \"/var/log/letsencrypt/:/var/log/letsencrypt/\" \
      -p 80:80 \
      certbot/certbot renew --quiet --reuse-key" >> /etc/crontab
  - systemctl restart cron

  # DANE TLSA status page. Serves /opt/dane-status on port 8082 with a plain
  # python http.server so UptimeRobot has a URL to keyword-check, and runs the
  # check daily so the page reflects the current state.
  - mkdir -p /opt/dane-status
  - chmod 0755 /usr/local/bin/tlsa-check
  - chmod 0755 /usr/local/bin/dane-status-server
  - |
    cat <<EOF > /etc/systemd/system/dane-status.service
    [Unit]
    Description=DANE TLSA status page
    After=network.target

    [Service]
    ExecStart=/usr/bin/python3 /usr/local/bin/dane-status-server
    Restart=on-failure

    [Install]
    WantedBy=multi-user.target
    EOF
  - systemctl daemon-reload
  - systemctl enable dane-status
  - systemctl start dane-status
  - |
    echo "# check DANE TLSA daily at 9am" >> /etc/crontab
  - |
    echo "0 9 * * * root /usr/local/bin/tlsa-check" >> /etc/crontab
  - |
    echo "*/5 * * * * root /usr/local/bin/disk-check" >> /etc/crontab
  - systemctl restart cron
  - /usr/local/bin/disk-check

  # apply journald size cap
  - systemctl restart systemd-journald

  # block container access to the Hetzner metadata service
  - /usr/local/bin/docker-metadata-block
  - systemctl daemon-reload
  - systemctl enable docker-metadata-block.service

  # mail server
  - |
    cat <<EOF > /etc/systemd/system/mail.service
    [Unit]
    Description=mail
    After=docker.service
    Requires=docker.service

    [Service]
    PermissionsStartOnly=true
    Restart=on-failure
    ExecStart=/usr/bin/docker run \
      --rm \
      --name mail \
      -e MAILBOX_LIMIT_MB=5120 \
      --hostname ${mailserver_hostname}.${domain_name} \
      --dns=1.1.1.1 \
      --dns=1.0.0.1 \
      --cap-add=NET_ADMIN \
      --cap-add=SYS_PTRACE \
      -e OVERRIDE_HOSTNAME=${mailserver_hostname}.${domain_name} \
      -e DOMAINNAME=${domain_name} \
      -e ENABLE_CLAMAV=1 \
      -e ENABLE_FAIL2BAN=1 \
      -e ENABLE_MANAGESIEVE=1 \
      -e ENABLE_POSTGREY=0 \
      -e ENABLE_SPAMASSASSIN=1 \
      -e DMS_DEBUG=0 \
      -e ONE_DIR=1 \
      -e SPAMASSASSIN_SPAM_TO_INBOX=1 \
      -e SSL_TYPE=letsencrypt \
      -p 25:25 \
      -p 465:465 \
      -p 993:993 \
      -v /mail/data:/var/mail:rw \
      -v /mail/state:/var/mail-state:rw \
      -v /mail/config/:/tmp/docker-mailserver:rw \
      -v /etc/letsencrypt:/etc/letsencrypt:rw \
      -v /etc/localtime:/etc/localtime:ro \
      ghcr.io/docker-mailserver/docker-mailserver:${docker_mailserver_version}
    ExecStop=/usr/bin/docker stop mail

    [Install]
    WantedBy=multi-user.target
    EOF
  - systemctl daemon-reload
  - systemctl enable mail
  - systemctl start mail

  # pangolin server
  - mkdir -p /opt/pangolin/config/traefik
  - |
    cat <<EOF > /opt/pangolin/docker-compose.yml
    name: pangolin
    services:
      pangolin:
        image: docker.io/fosrl/pangolin:1.25.3
        container_name: pangolin
        restart: unless-stopped
        deploy:
          resources:
            limits:
              memory: 1g
            reservations:
              memory: 256m
        volumes:
          - ./config:/app/config
        healthcheck:
          test: ["CMD", "curl", "-f", "http://localhost:3001/api/v1/"]
          interval: "10s"
          timeout: "10s"
          retries: 15

      gerbil:
        image: docker.io/fosrl/gerbil:1.5.2
        container_name: gerbil
        restart: unless-stopped
        depends_on:
          pangolin:
            condition: service_healthy
        command:
          - --reachableAt=http://gerbil:3004
          - --generateAndSaveKeyTo=/var/config/key
          - --remoteConfig=http://pangolin:3001/api/v1/
        volumes:
          - ./config/:/var/config
        cap_add:
          - NET_ADMIN
          - SYS_MODULE
        ports:
          - 51820:51820/udp
          - 21820:21820/udp
          - 443:443
          - 443:443/udp
          - 8081:8081

      traefik:
        image: docker.io/traefik:v3.7.16
        container_name: traefik
        restart: unless-stopped
        network_mode: service:gerbil
        depends_on:
          pangolin:
            condition: service_healthy
        command:
          - --configFile=/etc/traefik/traefik_config.yml
        volumes:
          - ./config/traefik:/etc/traefik:ro
          - ./config/letsencrypt:/letsencrypt
          - ./config/traefik/logs:/var/log/traefik

      newt:
        image: docker.io/fosrl/newt:1.19.0
        container_name: newt
        restart: unless-stopped
        network_mode: host
        environment:
          - PANGOLIN_ENDPOINT=https://pangolin.dtlp.cc
          - NEWT_ID=${newt_id}
          - NEWT_SECRET=${newt_secret}

    networks:
      default:
        driver: bridge
        name: pangolin
    EOF
  - |
    cat <<EOF > /opt/pangolin/config/config.yml
    # To see all available options, please visit the docs:
    # https://docs.pangolin.net/

    gerbil:
        start_port: 51820
        base_endpoint: "pangolin.dtlp.cc"

    app:
        dashboard_url: "https://pangolin.dtlp.cc"
        log_level: "info"
        telemetry:
            anonymous_usage: true

    domains:
        domain1:
            base_domain: "dtlp.cc"

    server:
        secret: ${pangolin_server_secret}
        cors:
            origins: ["https://pangolin.dtlp.cc"]
            methods: ["GET", "POST", "PUT", "DELETE", "PATCH"]
            allowed_headers: ["X-CSRF-Token", "Content-Type"]
            credentials: false
        maxmind_db_path: "./config/GeoLite2-Country.mmdb"

    flags:
        require_email_verification: false
        disable_signup_without_invite: true
        disable_user_create_org: false
        allow_raw_resources: true
    EOF
  - cd /opt/pangolin && docker compose up -d

  # ente photos
  - mkdir -p /opt/ente/data
  - cd /opt/ente && docker compose up -d

  # telegram docker-mailserver admin bot
  - mkdir -p /opt/dms-admin-bot
  - |
    cat <<EOF > /opt/dms-admin-bot/docker-compose.yaml
    name: dms-admin-bot
    services:
      docker-socket-proxy:
        image: tecnativa/docker-socket-proxy:v0.5.0@sha256:1f5038b54f06c3e18422902cf00ba21803d1c97805aae032e5e6673d532d3459
        container_name: docker-socket-proxy
        restart: unless-stopped
        privileged: true
        environment:
          CONTAINERS: "1"
          EXEC: "1"
          POST: "1"
        volumes:
          - /var/run/docker.sock:/var/run/docker.sock:ro

      dms-admin-bot:
        image: ghcr.io/dtlp/dms-admin-bot:${dms_admin_bot_version}
        container_name: dms-admin-bot
        restart: unless-stopped
        logging:
          driver: json-file
          options:
            max-size: "10m"
            max-file: "3"
        depends_on:
          - docker-socket-proxy
        environment:
          DOCKER_HOST: tcp://docker-socket-proxy:2375
          BOT_TOKEN: ${telegram_bot_token}
          BOT_USER_ID: ${telegram_bot_user_id}
          MAIL_CONTAINER: mail
          MAIL_DOMAIN: ${domain_name}
    EOF
  - cd /opt/dms-admin-bot && docker compose up -d

  # Weekly reboot only if a kernel or other update asked for one. Enabled last
  # so the timer cannot fire in the middle of provisioning.
  - systemctl daemon-reload
  - systemctl enable --now reboot-if-required.timer

  # Daily encrypted email backup to Dropbox
  - mkdir -p /var/backups/email
  - chmod 0700 /etc/email-backup /var/backups/email
  - chmod 0600 /etc/email-backup/passphrase /etc/email-backup/rclone.conf
  - chmod 0755 /usr/local/bin/email-backup
  - systemctl daemon-reload
  - systemctl enable --now email-backup.timer
